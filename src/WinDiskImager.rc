/////////////////////////////////////////////////////////////////////////////
// English (U.S.) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
#ifdef _WIN32
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)
#endif //_WIN32

/////////////////////////////////////////////////////////////////////////////
//
// RT_MANIFEST
//

#ifdef TEST_NO_ADMIN
// GUI-testing build without elevation; the manifest is generated into the
// build directory by CMake's TEST_NO_ADMIN option.
1                       RT_MANIFEST             "WinDiskImager-asinvoker.manifest"
#else
1                       RT_MANIFEST             "WinDiskImager.manifest"
#endif

#ifdef APSTUDIO_INVOKED
/////////////////////////////////////////////////////////////////////////////
//
// TEXTINCLUDE
//

1 TEXTINCLUDE
BEGIN
    "resource.\0"
END

3 TEXTINCLUDE
BEGIN
    "\r\0"
END

#endif    // APSTUDIO_INVOKED


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

// VER_TUPLE and VER_RAW come from src/CMakeLists.txt, the only place the
// version is written (the release job checks the tag against it). Strings are
// rebuilt with # because windres strips the quotes from -D values.
#define RC_STR2(x) #x
#define RC_STR(x)  RC_STR2(x)
VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_TUPLE
 PRODUCTVERSION VER_TUPLE
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x0L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "Writes and reads raw disk images for USB and SD devices on Windows"
            VALUE "FileDescription", "WinDiskImager"
            VALUE "FileVersion", RC_STR(VER_RAW)
            VALUE "InternalName", "WinDiskImager"
            VALUE "LegalCopyright", "Copyright (C) 2009-2017 Windows ImageWriter Team; modifications Copyright (C) 2026 peacepenguin. GPL-2.0-or-later."
            VALUE "OriginalFilename", "WinDiskImager"
            VALUE "ProductName", "WinDiskImager"
            VALUE "ProductVersion", RC_STR(VER_RAW)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_ICON1               ICON                    "images/WinDiskImager.ico"
