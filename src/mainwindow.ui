             <normaloff>:/images/images/browse.svg</normaloff>:/images/images/browse.svg</iconset>
           </property>
          </widget>
         </item>
        </layout>
     </widget>
    </item>
    <item>
     <layout class="QHBoxLayout" name="actionRow">
      <item>
       <spacer name="actionLeftSpacer">
