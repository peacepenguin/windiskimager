    <item>
     <widget class="QGroupBox" name="groupBox_2">
      <property name="title">
       <string>Device</string>
      </property>
        
     <layout class="QVBoxLayout" name="deviceColumn">
      <item>
        <layout class="QHBoxLayout">
         <property name="spacing">
          <number>0</number>
         </property>
         <property name="leftMargin">
          <number>2</number>
         </property>
         <property name="topMargin">
          <number>2</number>
         </property>
         <property name="rightMargin">
          <number>2</number>
         </property>
         <property name="bottomMargin">
          <number>2</number>
         </property>
         <item>
          <widget class="DeviceComboBox" name="cboxDevice">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
             <horstretch>1</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <!-- Device entries carry a size and a model name, so the box needs
                room for more than a drive letter. -->
           <property name="minimumContentsLength">
            <number>28</number>
           </property>
           <property name="sizeAdjustPolicy">
            <enum>QComboBox::AdjustToMinimumContentsLengthWithIcon</enum>
           </property>
          </widget>
         </item>
        </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="deviceOptionsColumns">
        <item>
         <layout class="QVBoxLayout" name="deviceOptionsColMisc">
          <item>
       <widget class="QCheckBox" name="showAllDevicesCheckBox">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="text">
         <string>Show all devices</string>
        </property>
        <property name="toolTip">
         <string>Also list fixed disks. Internal PCIe card readers often present the card as a non-removable device, which is otherwise hidden. The disk Windows is running from is never listed.</string>
        </property>
       </widget>
          </item>
          <item>
       <widget class="QCheckBox" name="fixGptCheckBox">
        <property name="checked">
         <bool>true</bool>
        </property>
        <property name="sizePolicy">
         <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="text">
         <string>Fix GPT after write</string>
        </property>
        <property name="toolTip">
         <string>After writing, move the backup GPT to the end of the device and update the header to match, so Windows has nothing to "repair". Leave unchecked to be warned to remove the device instead.</string>
        </property>
       </widget>
          </item>
          <item>
         <widget class="QPushButton" name="bCheckGpt">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <property name="text">
           <string>Check GPT</string>
          </property>
          <property name="toolTip">
           <string>Check the currently selected device for GPT corruption and offer to repair it.</string>
          </property>
         </widget>
          </item>
         </layout>
        </item>
        <item>
         <layout class="QVBoxLayout" name="deviceOptionsColRead">
          <item>
       <widget class="QCheckBox" name="shrinkOnReadCheckBox">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="text">
         <string>Skip unpartitioned space</string>
        </property>
        <property name="toolTip">
         <string>Reads the MBR or GPT of the Device and leaves out the unpartitioned space between and after its partitions. Up to 32 MB of the space before the first partition, where a bootloader might be stored in unused space, is read as it is; only space beyond that is left out. The backup GPT is moved to the new end of the image.</string>
        </property>
       </widget>
          </item>
          <item>
       <widget class="QCheckBox" name="compressReadCheckBox">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="text">
         <string>Compress during Read</string>
        </property>
        <property name="toolTip">
         <string>Compress the Image Read from the Device, in the format chosen below</string>
        </property>
       </widget>
          </item>
          <item>
       <widget class="QComboBox" name="compressFormatComboBox">
        <property name="enabled">
         <bool>false</bool>
        </property>
        <property name="sizePolicy">
         <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="sizeAdjustPolicy">
         <enum>QComboBox::AdjustToContents</enum>
        </property>
        <property name="toolTip">
         <string>The compressed format to Read to: .img.zst is the fastest, .img.xz the smallest, and .img.gz the most widely supported</string>
        </property>
        <item>
         <property name="text">
          <string notr="true">.img.gz</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string notr="true">.img.xz</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string notr="true">.img.bz2</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string notr="true">.img.zst</string>
         </property>
        </item>
       </widget>
          </item>
          <item>
       <widget class="QCheckBox" name="choosePartitionsCheckBox">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="text">
         <string>Choose partitions to read</string>
        </property>
        <property name="toolTip">
         <string>Before reading, list the Device's partitions and choose which to include. Anything left out is removed from the image, the same as unpartitioned space -- this always skips unpartitioned space too, whether or not "Skip unpartitioned space" is also checked.</string>
        </property>
       </widget>
          </item>
         </layout>
        </item>
       </layout>
      </item>
     </layout>
     </widget>
    </item>
    <item>
     <widget class="QGroupBox" name="hashGroup">
