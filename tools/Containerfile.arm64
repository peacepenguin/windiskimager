# Cross-compile image for Windows-on-ARM64 builds from Linux. The toolkit --
# llvm-mingw, zlib, xz, zstd, bzip2 and Qt -- is built by tools/woa64-env.sh,
# from Fedora's source RPMs and llvm-mingw's newest release; see it for how.
#
#   podman build -t w32di-build-arm64 --build-arg BASE=quay.io/fedora/fedora-minimal:latest \
#       -f tools/Containerfile.arm64 .
#
# tools/build-container-arm64.sh builds it on first use, as WOA64_IMAGE, and
# rebuilds it when what it was built from has been updated. Expect each build
# to take a long while, most of it Qt, and the image to be several GB.
#
# The ENV below is what tools/woa64-env.sh env prints: with it, the same
# tools/build-cross.sh and tools/deploy-cross.sh the x64 image runs build and
# package for ARM64 instead.
#
# See BUILD.md, "Windows on ARM64, cross-compiled from Linux".
ARG BASE=quay.io/fedora/fedora-minimal:latest
FROM ${BASE}

COPY tools/build-env.sh tools/woa64-env.sh /usr/local/lib/
# The secret is the optional GitHub token container_run passes (see
# woa64_llvm_mingw_release); it is mounted for this step only, not stored.
RUN --mount=type=secret,id=github_token \
    bash /usr/local/lib/woa64-env.sh install && dnf clean all

ENV PATH=/opt/llvm-mingw/bin:$PATH \
    CROSS_TOOLCHAIN=/opt/woa64/sysroot/lib/cmake/Qt6/qt.toolchain.cmake \
    CROSS_SYSROOT=/opt/woa64/sysroot \
    CROSS_XZ_PREFIX=/opt/woa64/sysroot \
    OBJDUMP=llvm-objdump \
    STRIP=llvm-strip \
    W32DI_DEPLOY_HINT=tools/deploy-container-arm64.sh

WORKDIR /src
