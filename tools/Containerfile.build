# Cross-compile image for win64 builds from Linux; the toolchain is installed by
# tools/build-env.sh, the same as in CI.
#
#   podman build -t w32di-build --build-arg BASE=fedora:latest \
#       -f tools/Containerfile.build .
#
# container_run passes BASE from CROSS_BASE_IMAGE; the default below is only for
# building by hand. build-env.sh is the only file copied in, so editing it
# rebuilds the layer and editing anything else does not.
#
# See BUILD.md, "Windows, cross-compiled from Linux".
ARG BASE=fedora:latest
FROM ${BASE}

COPY tools/build-env.sh /usr/local/lib/build-env.sh
RUN bash /usr/local/lib/build-env.sh install && dnf clean all

WORKDIR /src
